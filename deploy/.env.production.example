# Production environment template — MICT-RAG-002 S06
# Copy to .env.production, fill every __REPLACE_ME__, then source before deploy.
# NEVER commit .env.production to git.
#
# Placeholder convention: every sensitive value is __REPLACE_ME__

# --- Postgres ---
POSTGRES_USER=__REPLACE_ME__
POSTGRES_PASSWORD=__REPLACE_ME__
POSTGRES_DB=__REPLACE_ME__
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# --- n8n ---
N8N_ENCRYPTION_KEY=__REPLACE_ME__
WEBHOOK_URL=https://docs.jakemorganlabs.dev/

# --- Generation — Google Gemma via DeepInfra (§15, NFR-MA-2) ---
#   Base URL: https://api.deepinfra.com/v1/openai
#   Model:   google/gemma-4-26B-A4B-it
#   No Anthropic/Claude/Haiku models are used anywhere in this system.
GOOGLE_GENAI_API_KEY=__REPLACE_ME__
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
GEMMA_MODEL_ID=google/gemma-4-26B-A4B-it

# --- Embeddings (OpenAI) ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL_ID=text-embedding-3-small
EMBEDDING_PROVIDER_API_KEY=__REPLACE_ME__

# --- Security — HMAC shared secret (§16, NFR-SE-1) ---
#   Every production request must carry X-Timestamp + X-Signature headers.
#   Signing scheme: base64(HMAC-SHA256(secret, timestamp || body))
HMAC_SECRET=__REPLACE_ME__

# --- Observability ---
SLACK_WEBHOOK_URL=__REPLACE_ME__

# --- Retrieval parameters (tunable) ---
SIMILARITY_FLOOR=__REPLACE_ME__
TOP_K=__REPLACE_ME__

# --- Cloudflare Tunnel ---
TUNNEL_TOKEN=__REPLACE_ME__

# --- Port override (kept for local parity) ---
PORT=3000
