{
  "name": "document-intelligence-rag",
  "version": "1.1.0",
  "description": "Document Intelligence: grounded RAG with citations. Portfolio Piece II (MICT-RAG-002).",
  "repository": {
    "type": "git",
    "url": "https://github.com/jakemorganlabs/document-intelligence-rag.git"
  },
  "bugs": {
    "url": "https://github.com/jakemorganlabs/document-intelligence-rag/issues"
  },
  "homepage": "https://docs.jakemorganlabs.dev",
  "keywords": [
    "rag",
    "citations",
    "grounded-generation",
    "document-intelligence",
    "abstention"
  ],
  "author": "jakemorganlabs",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:fresh": "tsx scripts/migrate-fresh.ts",
    "ingest": "tsx scripts/ingest.ts",
    "ingest:smoke": "bash scripts/ingest_smoke.sh",
    "embed:pending": "tsx scripts/embed_pending.ts",
    "query": "tsx scripts/query.ts",
    "query:smoke": "bash scripts/query_smoke.sh",
    "eval": "tsx evals/run.ts && tsx evals/report.ts",
    "eval:clean": "tsx evals/run.ts --clean && tsx evals/report.ts",
    "serve": "tsx src/server.ts",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.11",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "openai": "^6.44.0",
    "pg": "^8.14.0",
    "tiktoken": "^1.0.0"
  }
}
