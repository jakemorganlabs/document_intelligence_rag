# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docintel
PGVECTOR_VERSION=pg16

# App
NODE_ENV=development
PORT=3000

# Embedding (OpenAI text-embedding-3-small at ingest/query time)
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL_ID=text-embedding-3-small
# EMBEDDING_PROVIDER_API_KEY=

# Generation — Google Gemma via Google AI Studio or Vertex AI
GOOGLE_GENAI_API_KEY=

# HMAC shared secret for query endpoint authentication (S05 → S06)
# HMAC_SECRET=__REPLACE_ME__
